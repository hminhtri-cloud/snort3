#!/bin/bash
${common}

hostnamectl set-hostname wazuh-siem
cat > /etc/sysctl.d/99-wazuh-indexer.conf <<'SYSCTL'
vm.max_map_count = 262144
SYSCTL
sysctl --system

# Generated passwords stay root-only on the SIEM, not in Terraform state.
umask 077
install -d -m 0700 /root/wazuh-install
cd /root/wazuh-install
retry curl -fL --retry 5 -o wazuh-install.sh https://packages.wazuh.com/4.14/wazuh-install.sh
bash wazuh-install.sh -a
chmod 0600 /var/log/wazuh-install.log

# Snort 3 fast output can differ from Snort 2's builtin decoder format.
# A decoder limited to these three lab signatures guarantees explicit mapping.
cat > /var/ossec/etc/decoders/snort_lab_decoders.xml <<'DECODER'
<decoder name="snort3-lab">
  <prematch type="pcre2">\[1:100000[123]:\d+\]</prematch>
  <regex type="pcre2">\[1:(100000[123]):\d+\]</regex>
  <order>id</order>
</decoder>
DECODER

cat > /var/ossec/etc/rules/snort_lab_rules.xml <<'RULES'
<group name="snort3_lab,ids,">
  <rule id="110000" level="3">
    <decoded_as>snort3-lab</decoded_as>
    <description>Snort 3 lab event: SID $(id)</description>
  </rule>
  <rule id="110001" level="5">
    <if_sid>110000</if_sid>
    <id>^1000001$</id>
    <description>Snort: LAB ICMP echo to victim</description>
  </rule>
  <rule id="110002" level="7">
    <if_sid>110000</if_sid>
    <id>^1000002$</id>
    <description>Snort: LAB TCP SYN to victim</description>
  </rule>
  <rule id="110003" level="8">
    <if_sid>110000</if_sid>
    <id>^1000003$</id>
    <description>Snort: LAB HTTP admin URI</description>
  </rule>
</group>
RULES
chown root:wazuh /var/ossec/etc/decoders/snort_lab_decoders.xml /var/ossec/etc/rules/snort_lab_rules.xml
chmod 0640 /var/ossec/etc/decoders/snort_lab_decoders.xml /var/ossec/etc/rules/snort_lab_rules.xml
# Avoid the builtin Snort 2 parent decoder consuming a Snort 3 event before
# the lab decoder. This SIEM is dedicated to the lab's three Snort 3 SIDs.
python3 - <<'PY'
from pathlib import Path
path = Path('/var/ossec/etc/ossec.conf')
text = path.read_text()
exclude = '<decoder_exclude>0285-snort_decoders.xml</decoder_exclude>'
if exclude not in text:
    if '</ruleset>' not in text:
        raise RuntimeError('Wazuh installer did not create a ruleset section')
    text = text.replace('</ruleset>', '  ' + exclude + '\n  </ruleset>', 1)
path.write_text(text)
PY
/var/ossec/bin/wazuh-analysisd -t
systemctl restart wazuh-manager
systemctl is-active --quiet wazuh-manager wazuh-indexer wazuh-dashboard filebeat
touch /var/lib/snort-lab-bootstrap.done
